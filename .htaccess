Options -Indexes
DirectoryIndex index.php index.html
DirectorySlash Off

<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(sql|md|log|ini)$|config\.local\.php$|^router\.php$)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Application internals are never served directly.
  RewriteRule ^(app|db|setup)(/|$) - [F,L]

  # Legacy .html and static dashboard URLs.
  RewriteRule ^pages/(about|services|team|contact)\.html$ /$1 [R=301,L,NE]
  RewriteRule ^(about|services|team|contact)\.html$ /$1 [R=301,L,NE]
  RewriteRule ^(about|services|team|contact)/(index\.html)?$ /$1 [R=301,L,NE]
  RewriteRule ^index\.html$ / [R=301,L,NE]
  RewriteRule ^(register|login|admin-login)/index\.html$ /$1/ [R=301,L,NE]
  RewriteRule ^register/complete/index\.html$ /register/complete/ [R=301,L,NE]
  RewriteRule ^(admin|client)/dashboard/index\.html$ /$1/dashboard/ [R=301,L,NE]

  # Dedicated client service workspace: /client/services/{slug}
  RewriteRule ^client/services/?$ /client/dashboard/ [R=302,L]
  RewriteRule ^client/services/([a-z0-9-]{1,80})/?$ client/services/index.php?slug=$1 [QSA,L]

  # Clean public page URLs.
  RewriteRule ^(about|services|team|contact)$ pages/$1.php [END]
</IfModule>

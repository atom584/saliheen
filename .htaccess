Options -Indexes
DirectoryIndex index.php
DirectorySlash Off

<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(sql|md|log|ini)$|config\.local\.php$|^router\.php$)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Application internals are never served directly.
  RewriteRule ^(app|db|routes|setup)(/|$) - [F,L]

  # Legacy .html entry points from the static prototype.
  RewriteRule ^(about|services|team|contact)\.html$ /$1 [R=301,L,NE,QSA]
  RewriteRule ^(about|services|team|contact)/index\.html$ /$1 [R=301,L,NE,QSA]
  RewriteRule ^index\.html$ / [R=301,L,NE,QSA]
  RewriteRule ^(login|admin-login|register|forgot-password|reset-password|verify)/index\.html$ /$1 [R=301,L,NE,QSA]
  RewriteRule ^register/complete/index\.html$ /register/complete [R=301,L,NE,QSA]
  RewriteRule ^(admin|client)/dashboard/index\.html$ /$1/dashboard [R=301,L,NE,QSA]

  # Front controller: everything else is resolved by routes/web.php.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
